{
  "app-id": "io.github.Praneel7015.Shrutadhara",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "shruta",
  "default-branch": "experimental",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--socket=pulseaudio",
    "--filesystem=~/Meetings/Flatpak:create"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "pulseaudio-clients",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddaemon=false",
        "-Dclient=true",
        "-Ddoxygen=false",
        "-Dman=false",
        "-Dtests=false",
        "-Ddatabase=simple",
        "-Dauto_features=disabled",
        "-Dglib=enabled"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-17.0.tar.xz",
          "sha256": "053794d6671a3e397d849e478a80b82a63cb9d8ca296bd35b73317bb5ceb87b5"
        }
      ]
    },
    {
      "name": "ffmpeg-audio",
      "config-opts": [
        "--disable-doc",
        "--disable-debug",
        "--disable-static",
        "--enable-shared",
        "--disable-autodetect",
        "--disable-x86asm",
        "--disable-everything",
        "--enable-ffmpeg",
        "--enable-ffprobe",
        "--enable-avdevice",
        "--enable-swresample",
        "--enable-avfilter",
        "--enable-protocol=file,pipe",
        "--enable-indev=pulse",
        "--enable-libpulse",
        "--enable-demuxer=matroska,wav",
        "--enable-muxer=matroska,wav,segment,pcm_s16le",
        "--enable-decoder=pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le",
        "--enable-encoder=pcm_s16le",
        "--enable-filter=aresample,aformat,anull,atrim,amix,alimiter,astats,abuffer,abuffersink"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ffmpeg.org/releases/ffmpeg-7.1.3.tar.xz",
          "sha256": "f0bf043299db9e3caacb435a712fc541fbb07df613c4b893e8b77e67baf3adbe"
        }
      ]
    },
    {
      "name": "python-dependencies",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -c \"import glob,zipfile; [zipfile.ZipFile(p).extractall('/app/share/shrutadhara') for p in glob.glob('*.whl')]\""
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/64/b4/17d4b0b2a2dc85a6df63d1157e028ed19f90d4cd97c36717afef2bc2f395/attrs-26.1.0-py3-none-any.whl",
          "sha256": "c647aa4a12dfbad9333ca4e71fe62ddc36f4e63b2d260a37a8b83d2f043ac309"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/2c/58/ca301544e1fa93ed4f80d724bf5b194f6e4b945841c5bfd555878eea9fcb/referencing-0.37.0-py3-none-any.whl",
          "sha256": "381329a9f99628c9069361716891d34ad94af76e461dcb0335825aecc7692231"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/41/45/1a4ed80516f02155c51f51e8cedb3c1902296743db0bbc66608a0db2814f/jsonschema_specifications-2025.9.1-py3-none-any.whl",
          "sha256": "98802fee3a11ee76ecaca44429fda8a41bff98b00a0f2838151b113f210cc6fe"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/22/9d/d08a1128ab199b2f0cf25bfeb0639bd05119fff4b7c47bec24ef9a8ec23f/rpds_py-2026.9.1-cp314-cp314-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
          "sha256": "eac2f5dbafd585dfe31f86a23ebf0d3ba480a9d49ebc87947267b5608d4ea0cd"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/57/ca/e2e9a0a46a74ed51a0498ba1fe10f4ea6b2d9a155f372a2f91e51f18cf10/rpds_py-2026.9.1-cp315-cp315-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
          "sha256": "2c16ab111bc27c646ba8aa005d0527754edc538ebb636f0b1bf8e244b48d1945"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/69/90/f63fb5873511e014207a475e2bb4e8b2e570d655b00ac19a9a0ca0a385ee/jsonschema-4.26.0-py3-none-any.whl",
          "sha256": "d489f15263b8d200f8387e64b4c3a75f06629559fb73deb8fdfb525f2dab50ce"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/18/67/36e9267722cc04a6b9f15c7f3441c2363321a3ea07da7ae0c0707beb2a9c/typing_extensions-4.15.0-py3-none-any.whl",
          "sha256": "f0fa19c6845758ab08074a0cfa8b7aecb71c999ca73d62883bc25cc018c4e548"
        }
      ]
    },
    {
      "name": "shrutadhara",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/shrutadhara",
        "cp -r shrutadhara /app/share/shrutadhara/",
        "install -Dm755 packaging/flatpak/shruta-flatpak /app/bin/shruta",
        "install -Dm644 desktop/io.github.Praneel7015.Shrutadhara.desktop /app/share/applications/io.github.Praneel7015.Shrutadhara.desktop",
        "sed -i 's/Icon=audio-input-microphone/Icon=io.github.Praneel7015.Shrutadhara/;s/Comment=.*/Comment=Record meetings and prepare audio locally/' /app/share/applications/io.github.Praneel7015.Shrutadhara.desktop",
        "install -Dm644 packaging/flatpak/io.github.Praneel7015.Shrutadhara.svg /app/share/icons/hicolor/scalable/apps/io.github.Praneel7015.Shrutadhara.svg",
        "install -Dm644 packaging/flatpak/io.github.Praneel7015.Shrutadhara.metainfo.xml /app/share/metainfo/io.github.Praneel7015.Shrutadhara.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/shrutadhara/LICENSE",
        "install -Dm644 NOTICE /app/share/licenses/shrutadhara/NOTICE"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "../../dist/shrutadhara-flatpak-source.tar.gz"
        }
      ]
    }
  ]
}
