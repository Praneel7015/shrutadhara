[Unit]
Description=Teams call notifications for Shrutadhara (no automatic recording)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Source launcher default. Native packages: /usr/bin/shruta watch.
# npm: substitute the absolute wrapper path before enabling this user unit.
ExecStart=%h/.local/bin/shruta watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
